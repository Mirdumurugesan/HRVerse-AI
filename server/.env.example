# ─────────────────────────────────────────────────────────────
# HRVerse AI — Server Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hrverse?retryWrites=true&w=majority

# JWT secret — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret

# ── AI Chain: Groq (primary) → OpenRouter (secondary) ────────
# Groq — fast, free tier available
# Get key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter — optional secondary fallback
# Get key at: https://openrouter.ai/keys
# Leave blank to skip the secondary fallback
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS (optional) ──────────────────────────────────────────
# Production frontend URL — leave blank for localhost-only
CLIENT_URL=https://your-frontend-domain.com
